<Window x:Class="LineCast.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LineCast.Controls"
        Title="LineCast"
        Width="1200"
        Height="768"
        MinWidth="1000"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnFilesDropped">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="StatusChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Background" Value="{DynamicResource Bg.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CardIcon" TargetType="Border">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
            <Setter Property="Margin" Value="0,0,9,0" />
        </Style>

        <Style x:Key="MiniIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="Swatch" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Ring"
                                CornerRadius="18"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                Padding="4">
                            <Border x:Name="Dot" CornerRadius="12" Background="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerAction" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ Header ═══════════════ -->
        <Grid Grid.Row="0" Margin="22,18,22,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{DynamicResource Accent.Soft}"
                        BorderBrush="{DynamicResource Accent}"
                        BorderThickness="1">
                    <Image Source="pack://application:,,,/Assets/linecast.ico"
                           Width="26" Height="26"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LineCast" Style="{StaticResource HeroTitle}" FontSize="21" />
                    <TextBlock Text="Soundboard · microphone mixer"
                               Style="{StaticResource Caption}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatusChip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Text.Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CableReady}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Signal.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="Cable" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Secondary}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatusChip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Text.Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MicLive}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Signal.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="Mic" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Secondary}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatusChip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Text.Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SystemLive}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Signal.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="Desktop" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Secondary}" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource IconButton}"
                        Command="{Binding ToggleThemeCommand}"
                        Content="◐"
                        FontSize="15"
                        Margin="6,0,0,0"
                        ToolTip="Switch between the dark and light theme" />
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding ToggleSettingsCommand}"
                        Content="⚙"
                        FontSize="15"
                        Margin="4,0,0,0"
                        ToolTip="Settings, theme and hotkeys" />
            </StackPanel>
        </Grid>

        <!-- ═══════════════ Body ═══════════════ -->
        <Grid Grid.Row="1" Margin="22,0,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="352" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Routing sidebar ── -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Text="AUDIO ROUTING" Style="{StaticResource SectionLabel}" Margin="4,2,0,10" />

                    <!-- Microphone -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,11">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource CardIcon}">
                                        <TextBlock Text="◉" FontSize="12"
                                                   Foreground="{DynamicResource Accent.Text}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Microphone" Style="{StaticResource CardHeader}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding MicEnabled}"
                                          ToolTip="Mute or unmute the microphone in the call" />
                            </Grid>

                            <ComboBox ItemsSource="{Binding MicDevices}"
                                      SelectedItem="{Binding SelectedMic, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Margin="0,11,0,0" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:LevelMeter Height="6"
                                                     Level="{Binding MicLevel}"
                                                     TrackBrush="{DynamicResource Bg.Elevated}"
                                                     FillBrush="{DynamicResource Meter.Gradient}"
                                                     VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding MicVolumeText}"
                                           Style="{StaticResource Caption}" Margin="10,0,0,0" />
                            </Grid>

                            <Slider Value="{Binding MicVolume, Mode=TwoWay}" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding MicStateText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Virtual cable -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,11">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="⇄" FontSize="12"
                                               Foreground="{DynamicResource Accent.Text}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Virtual cable in" Style="{StaticResource CardHeader}" />
                            </StackPanel>

                            <ComboBox ItemsSource="{Binding InjectionDevices}"
                                      SelectedItem="{Binding SelectedInjection, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Margin="0,11,0,0" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:LevelMeter Height="6"
                                                     Level="{Binding OutputLevel}"
                                                     TrackBrush="{DynamicResource Bg.Elevated}"
                                                     FillBrush="{DynamicResource Meter.Gradient}"
                                                     VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding InjectionVolumeText}"
                                           Style="{StaticResource Caption}" Margin="10,0,0,0" />
                            </Grid>

                            <Slider Value="{Binding InjectionVolume, Mode=TwoWay}" Margin="0,7,0,0" />
                            <TextBlock Text="The call hears the microphone and your sounds through this device."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Monitor -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,11">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="▤" FontSize="12"
                                               Foreground="{DynamicResource Accent.Text}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Monitor" Style="{StaticResource CardHeader}" />
                            </StackPanel>

                            <ComboBox ItemsSource="{Binding MonitorDevices}"
                                      SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Margin="0,11,0,0" />

                            <CheckBox Content="Play clips on this device too"
                                      IsChecked="{Binding MonitorClips}"
                                      Margin="0,12,0,0" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Volume" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding MonitorVolumeText}"
                                           Style="{StaticResource Caption}" />
                            </Grid>

                            <Slider Value="{Binding MonitorVolume, Mode=TwoWay}" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- System audio -->
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,11">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource CardIcon}">
                                        <TextBlock Text="≈" FontSize="13"
                                                   Foreground="{DynamicResource Accent.Text}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Desktop audio" Style="{StaticResource CardHeader}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding SystemEnabled}"
                                          ToolTip="Mix the selected desktop output into the call" />
                            </Grid>

                            <ComboBox ItemsSource="{Binding SystemDevices}"
                                      SelectedItem="{Binding SelectedSystem, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Margin="0,11,0,0" />

                            <Slider Value="{Binding SystemVolume, Mode=TwoWay}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding SystemVolumeText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Drift-corrected WASAPI graph · no per-clip stream restarts"
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Margin="4,2,0,10" />
                </StackPanel>
            </ScrollViewer>

            <!-- ── Library ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Margin="0,2,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource Bg.Input}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="36"
                            Padding="11,0"
                            Margin="0,0,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontSize="14"
                                       Foreground="{DynamicResource Text.Muted}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MinHeight="30"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Filter by name or path">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      VerticalAlignment="Center"
                                                      Focusable="False"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Hidden" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="{Binding LibraryCountText}"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center"
                               Margin="14,0,14,0" />

                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnAddSounds"
                            Padding="16,0"
                            Content="+  Add sounds" />
                </Grid>

                <!-- Sound list -->
                <Grid Grid.Row="1">
                    <Border Style="{StaticResource Card}" ClipToBounds="True">
                        <DataGrid x:Name="SoundGrid"
                                  ItemsSource="{Binding SoundsView}"
                                  SelectedItem="{Binding SelectedSound, Mode=TwoWay}"
                                  RowHeight="58"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  MouseDoubleClick="OnSoundDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="*" MinWidth="300">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="Glyph" Width="34" Height="34" CornerRadius="9"
                                                        Background="{DynamicResource Bg.Elevated}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock x:Name="GlyphText" Text="♪" FontSize="14"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <Grid Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="330" />
                                                        <Border x:Name="PlayingTag"
                                                                Background="{DynamicResource Accent.Soft}"
                                                                CornerRadius="5"
                                                                Padding="6,1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="Collapsed">
                                                            <TextBlock Text="playing" FontSize="10"
                                                                       Foreground="{DynamicResource Accent.Text}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                                        <controls:WaveformView Width="96" Height="13"
                                                                              Peaks="{Binding Waveform}"
                                                                              BarBrush="{DynamicResource Accent.Text}"
                                                                              VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding FileName}"
                                                                   Style="{StaticResource Caption}"
                                                                   Margin="10,0,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="260"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter TargetName="Glyph" Property="Background" Value="{DynamicResource Accent}" />
                                                    <Setter TargetName="GlyphText" Property="Text" Value="▶" />
                                                    <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource Accent.On}" />
                                                    <Setter TargetName="PlayingTag" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                    <Setter TargetName="GlyphText" Property="Text" Value="!" />
                                                    <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource Signal.Warning}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="LENGTH" Width="82">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DurationText}"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="11.5" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="HOTKEY" Width="112">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="5"
                                                        Background="{DynamicResource Bg.Elevated}"
                                                        BorderBrush="{DynamicResource Border.Subtle}"
                                                        BorderThickness="1"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding HotkeyText}"
                                                               FontFamily="{StaticResource Font.Mono}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource Text.Secondary}" />
                                                </Border>
                                                <TextBlock Text="!"
                                                           Foreground="{DynamicResource Signal.Warning}"
                                                           FontWeight="Bold"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding HotkeyError}"
                                                           Visibility="{Binding HasHotkeyError, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource MiniIconButton}"
                                                        Content="✎"
                                                        Click="OnRenameSound"
                                                        ToolTip="Rename" />
                                                <Button Style="{StaticResource MiniIconButton}"
                                                        Content="✕"
                                                        Click="OnRemoveSound"
                                                        Margin="2,0,0,0"
                                                        ToolTip="Remove from library" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Empty state -->
                    <Border Background="{DynamicResource Bg.Surface}"
                            Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="60" Height="60" CornerRadius="17"
                                    Background="{DynamicResource Accent.Soft}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="♪" FontSize="26"
                                           Foreground="{DynamicResource Accent.Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No sounds yet"
                                       FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,16,0,0" />
                            <TextBlock Text="Drop audio files here, or add them from disk."
                                       Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <Button Content="Add sounds"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="OnAddSounds"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0"
                                    Padding="18,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Transport -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Width="44" Height="44" Padding="0"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnPlayPause"
                                ToolTip="Play or stop the selected sound (Space)">
                            <TextBlock Text="{Binding PlayPauseGlyph}" FontSize="14" />
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource PlayerAction}"
                                Margin="8,0,0,0"
                                Click="OnStopClick"
                                Content="■"
                                FontSize="10"
                                ToolTip="Stop (Esc)" />

                        <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NowPlayingName}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PositionText}"
                                       Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Text="Space · play/stop"
                                   Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" />

                        <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0">
                            <Slider x:Name="SeekSlider"
                                    Style="{StaticResource SeekSlider}"
                                    Maximum="{Binding DurationSeconds}"
                                    Value="{Binding SeekSeconds, Mode=TwoWay}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════ Status bar ═══════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource Bg.Surface}"
                BorderBrush="{DynamicResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="22,7"
                Margin="0,14,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Text.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CableReady}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Signal.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status}"
                               Style="{StaticResource Caption}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="760" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding BufferHealthText}"
                               Style="{StaticResource Caption}"
                               Margin="0,0,18,0" />
                    <TextBlock Text="Del · remove"
                               Style="{StaticResource Caption}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ Settings overlay ═══════════════ -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="20"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#B3000000" MouseLeftButtonDown="OnScrimClick" />

            <Border Width="400"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource Bg.Surface}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="22,18,16,10">
                        <TextBlock Text="Settings" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource IconButton}"
                                Content="✕"
                                Click="OnCloseSettings" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,22">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ToggleButton x:Name="DarkChip"
                                              Style="{StaticResource ChipToggle}"
                                              Content="Dark"
                                              Click="OnThemeDark"
                                              Margin="0,0,8,0" />
                                <ToggleButton x:Name="LightChip"
                                              Style="{StaticResource ChipToggle}"
                                              Content="Light"
                                              Click="OnThemeLight" />
                            </StackPanel>

                            <TextBlock Text="Accent" Style="{StaticResource Caption}" Margin="0,18,0,9" />
                            <StackPanel x:Name="AccentPanel" Orientation="Horizontal">
                                <ToggleButton Style="{StaticResource Swatch}" Background="#38BDF8" Tag="cyan"
                                              Click="OnAccentClick" Margin="0,0,6,0" ToolTip="Cyan" />
                                <ToggleButton Style="{StaticResource Swatch}" Background="#A78BFA" Tag="violet"
                                              Click="OnAccentClick" Margin="0,0,6,0" ToolTip="Violet" />
                                <ToggleButton Style="{StaticResource Swatch}" Background="#34D399" Tag="emerald"
                                              Click="OnAccentClick" Margin="0,0,6,0" ToolTip="Emerald" />
                                <ToggleButton Style="{StaticResource Swatch}" Background="#FBBF24" Tag="amber"
                                              Click="OnAccentClick" Margin="0,0,6,0" ToolTip="Amber" />
                                <ToggleButton Style="{StaticResource Swatch}" Background="#FB7185" Tag="rose"
                                              Click="OnAccentClick" Margin="0,0,6,0" ToolTip="Rose" />
                                <ToggleButton Style="{StaticResource Swatch}" Background="#60A5FA" Tag="blue"
                                              Click="OnAccentClick" ToolTip="Blue" />
                            </StackPanel>

                            <Separator Margin="0,22,0,0" />

                            <TextBlock Text="HOTKEYS" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Click a box, then press the combination. Backspace clears it."
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,12" />

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="152" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Play selected" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Tag="play"
                                         Text="{Binding HotkeyPlay, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Cursor="Hand"
                                         MinHeight="32"
                                         PreviewKeyDown="OnHotkeyCapture" />
                            </Grid>

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="152" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Stop playback" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Tag="stop"
                                         Text="{Binding HotkeyStop, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Cursor="Hand"
                                         MinHeight="32"
                                         PreviewKeyDown="OnHotkeyCapture" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="152" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Toggle microphone" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Tag="mic"
                                         Text="{Binding HotkeyToggleMic, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Cursor="Hand"
                                         MinHeight="32"
                                         PreviewKeyDown="OnHotkeyCapture" />
                            </Grid>

                            <Separator Margin="0,22,0,0" />

                            <TextBlock Text="AUDIO" Style="{StaticResource SectionLabel}" />
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Buffer latency" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LatencyText}"
                                           Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Slider Minimum="10" Maximum="120"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding LatencyMs, Mode=TwoWay}"
                                    Margin="0,7,0,0" />
                            <TextBlock Text="Lower feels tighter. Raise it if the meters stutter on a busy machine."
                                       Style="{StaticResource Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />

                            <CheckBox Content="Show virtual and unused devices"
                                      IsChecked="{Binding ShowAllDevices}"
                                      Margin="0,16,0,0" />

                            <Separator Margin="0,22,0,0" />

                            <TextBlock Text="SYSTEM" Style="{StaticResource SectionLabel}" />
                            <CheckBox Content="Minimize to tray"
                                      IsChecked="{Binding MinimizeToTray}"
                                      Margin="0,12,0,0" />
                            <CheckBox Content="Start minimized"
                                      IsChecked="{Binding StartMinimized}"
                                      Margin="0,12,0,0" />

                            <Button Content="Open settings folder"
                                    Click="OnOpenSettingsFolder"
                                    HorizontalAlignment="Left"
                                    Margin="0,18,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Text="LineCast 2.0 · WASAPI shared mode"
                               Style="{StaticResource Caption}"
                               Margin="22,0,22,18" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
