<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Surfaces (light) ──────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Bg.Window"     Color="#F1F4F9" />
    <SolidColorBrush x:Key="Bg.Surface"    Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.SurfaceAlt" Color="#F7F9FC" />
    <SolidColorBrush x:Key="Bg.Elevated"   Color="#E9EEF5" />
    <SolidColorBrush x:Key="Bg.Input"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.Hover"      Color="#E8EEF7" />
    <SolidColorBrush x:Key="Bg.Pressed"    Color="#DCE5F2" />

    <!-- ── Lines ─────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Border.Subtle" Color="#DCE3ED" />
    <SolidColorBrush x:Key="Border.Strong" Color="#C3CEDD" />
    <SolidColorBrush x:Key="Border.Focus"  Color="#9FB0C6" />

    <!-- ── Text ──────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#0F172A" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#475569" />
    <SolidColorBrush x:Key="Text.Muted"     Color="#7A889C" />
    <SolidColorBrush x:Key="Text.OnAccent"  Color="#08111C" />

    <!-- ── Semantic ──────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Signal.Success" Color="#0F9F6E" />
    <SolidColorBrush x:Key="Signal.Warning" Color="#B45309" />
    <SolidColorBrush x:Key="Signal.Danger"  Color="#DC2626" />

    <!-- ── Accent defaults (overridden at runtime by ThemeManager) ───── -->
    <SolidColorBrush x:Key="Accent"         Color="#0284C7" />
    <SolidColorBrush x:Key="Accent.Hover"   Color="#0EA5E9" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#0369A1" />
    <SolidColorBrush x:Key="Accent.Soft"    Color="#240284C7" />
    <SolidColorBrush x:Key="Accent.On"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="Accent.Text"    Color="#0369A1" />

    <LinearGradientBrush x:Key="Meter.Gradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.00" Color="#10B981" />
        <GradientStop Offset="0.72" Color="#0F9F6E" />
        <GradientStop Offset="0.88" Color="#D97706" />
        <GradientStop Offset="1.00" Color="#DC2626" />
    </LinearGradientBrush>

</ResourceDictionary>
