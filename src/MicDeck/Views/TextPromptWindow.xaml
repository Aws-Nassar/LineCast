<Window x:Class="MicDeck.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MicDeck"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True">

    <Border Padding="22">
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="Hint"
                       Style="{StaticResource Caption}"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />

            <TextBox x:Name="Input" Margin="0,16,0,0" MaxLength="160" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
                <Button Content="Save" IsDefault="True" MinWidth="88"
                        Style="{StaticResource PrimaryButton}" Click="OnSave" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
